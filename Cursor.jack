/**
 * Cursor: marco resaltado que indica la casilla actual.
 * Guarda la posicion logica (fila, columna); los pixeles se calculan
 * a partir del origen del tablero. El marco es de 2 px de grosor y se
 * dibuja justo dentro del borde de la casilla (sin pisar a las vecinas).
 */
class Cursor {
    field Board board;     // tablero sobre el que se mueve (no es dueno de el)
    field int row, col;    // casilla actual

    /** Crea el cursor en la casilla (0, 0). */
    constructor Cursor new(Board b) {
        let board = b;
        let row = 0;
        let col = 0;
        return this;
    }

    /** Dibuja el marco de 2 px dentro del borde de la casilla actual. */
    method void draw() {
        var int x, y;
        let x = board.getX() + (col * Cell.size());
        let y = board.getY() + (row * Cell.size());

        do Screen.setColor(true);
        do Screen.drawRectangle(x + 1, y + 1, x + 18, y + 2);     // arriba
        do Screen.drawRectangle(x + 1, y + 17, x + 18, y + 18);   // abajo
        do Screen.drawRectangle(x + 1, y + 1, x + 2, y + 18);     // izquierda
        do Screen.drawRectangle(x + 17, y + 1, x + 18, y + 18);   // derecha
        return;
    }

    /** No dibuja nada por si solo: Game redibuja la casilla con cell.draw()
        justo despues, y eso tapa el marco. */
    method void erase() {
        return;
    }

    /** Movimientos: el cursor se detiene en los bordes del tablero. */
    method void moveUp() {
        if (row > 0) {
            let row = row - 1;
        }
        return;
    }

    method void moveDown() {
        if (row < (board.getRows() - 1)) {
            let row = row + 1;
        }
        return;
    }

    method void moveLeft() {
        if (col > 0) {
            let col = col - 1;
        }
        return;
    }

    method void moveRight() {
        if (col < (board.getCols() - 1)) {
            let col = col + 1;
        }
        return;
    }

    method int getRow() { return row; }
    method int getCol() { return col; }

    /** Libera solo el cursor; el tablero lo libera Game. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
